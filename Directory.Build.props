<Project>

  <PropertyGroup>
    <Product>ALKAROS</Product>
    <Company>ALKAROS</Company>
    <Copyright>Copyright (c) ALKAROS. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <!--
      Target framework is deliberately pinned to net8.0 (LTS) so it matches the
      mcr.microsoft.com/dotnet/aspnet:8.0-alpine runtime base image in the
      Dockerfile. The build SDK in global.json intentionally rolls forward to
      10.0.x: a newer SDK building an LTS target framework is a supported
      configuration and keeps analyzers and build tooling current without
      changing the deployed runtime contract. Do not raise this value without
      also moving the runtime base image and re-running the deployment smoke
      tests. Per-project files still declare <TargetFramework> explicitly with
      the same value; this property is the single documented rationale.
      (deep-analysis finding B-6)
    -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionEnabled>false</CentralPackageFloatingVersionEnabled>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <ALKAROSRoot>$(MSBuildThisFileDirectory)</ALKAROSRoot>
    <ALKAROSSourceRoot>$(ALKAROSRoot)src\</ALKAROSSourceRoot>
    <ALKAROSTestsRoot>$(ALKAROSRoot)tests\</ALKAROSTestsRoot>
  </PropertyGroup>

  <Target Name="ResolveAndValidateRepositoryCommit" BeforeTargets="GenerateAssemblyInfo">
    <Exec Command="git rev-parse HEAD"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitCommitOutput" />
    </Exec>
    <PropertyGroup>
      <_DetectedRepositoryCommit>@(_GitCommitOutput)</_DetectedRepositoryCommit>
      <RepositoryCommit Condition="'$(RepositoryCommit)' == ''">$(_DetectedRepositoryCommit)</RepositoryCommit>
      <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">$(RepositoryCommit)</SourceRevisionId>
    </PropertyGroup>
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(RepositoryCommit)', '^[0-9a-f]{40}$')) != 'True'"
           Text="RepositoryCommit must be a lowercase 40-character Git SHA, but was '$(RepositoryCommit)'." />
    <Error Condition="'$(RepositoryCommit)' != '$(_DetectedRepositoryCommit)'"
           Text="RepositoryCommit '$(RepositoryCommit)' does not match checked-out Git HEAD '$(_DetectedRepositoryCommit)'." />
  </Target>

</Project>
