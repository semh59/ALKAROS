+// @vitest-environment jsdom
+
+import { act, createElement } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+(globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT: boolean }).IS_REACT_ACT_ENVIRONMENT = true;
+
+const jsonResponse = (body: unknown, status = 200) =>
+  new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });
+
+vi.mock("@microsoft/signalr", () => ({
+  LogLevel: { Warning: 2 },
+  HubConnectionBuilder: class {
+    withUrl() { return this; }
+    withAutomaticReconnect() { return this; }
+    configureLogging() { return this; }
+    build() {
+      return {
+        on: () => undefined, onreconnecting: () => undefined, onreconnected: () => undefined, onclose: () => undefined,
+        start: vi.fn(async () => undefined), stop: vi.fn(async () => undefined),
+      };
+    }
+  },
+}));
+
+const line = { lineId: "l", itemId: "i1", productId: "p-ayran", name: "Ayran", quantity: 1, unitPrice: 20, lineTotal: 20, discountAmount: 0 };
+const draft = (extra: Record<string, unknown> = {}) => ({
+  displayId: "d", terminalId: "terminal", orderId: "order-1", revision: 1, state: "Active", editable: true, orderNumber: "1",
+  lines: [line], subtotal: 20, discountTotal: 0, taxTotal: 0, total: 20, currency: "TRY", serverTimestamp: "", message: "", ...extra,
+});
+
+let root: Root | null = null;
+afterEach(() => {
+  if (root) act(() => root!.unmount());
+  root = null;
+  document.body.innerHTML = "";
+  vi.unstubAllGlobals();
+  vi.resetModules();
+});
+
+async function openTill(capabilities: string[], active: ReturnType<typeof draft>, submitStatus = 200) {
+  const calls: string[] = [];
+  const assign = vi.fn();
+  vi.stubGlobal("fetch", vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+    const path = String(input);
+    const method = init?.method ?? "GET";
+    calls.push(`${method} ${path.replace(/^.*\/api\/v1\/terminals\/[^/]+/, "")}`);
+    if (path.includes("/auth/session")) return jsonResponse({ userId: "user", displayName: "Deniz Kaya", terminalId: "terminal", capabilities });
+    if (path.endsWith("/catalog")) return jsonResponse([{ productId: "p-ayran", sku: "SKU-2", name: "Ayran", categoryCode: "ICE", categoryName: "İçecek", unitPrice: 20, taxRate: 10 }]);
+    if (path.endsWith("/orders/active")) return jsonResponse(active);
+    if (path.endsWith("/health/ready")) return jsonResponse({ status: "ready" });
+    if (path.endsWith("/submit")) return submitStatus === 200 ? jsonResponse({ rowVersion: 2 }) : jsonResponse({ error: { code: "X", message: "x" } }, submitStatus);
+    if (path.includes("/billing/bills/from-order/")) return jsonResponse({ billId: "bill-9" });
+    return jsonResponse({});
+  }));
+  const { Cashier } = await import("./Cashier");
+  const { RouterProvider } = await import("../router");
+  document.body.innerHTML = '<div id="root"></div>';
+  root = createRoot(document.getElementById("root")!);
+  await act(async () => { root!.render(createElement(RouterProvider, null, createElement(Cashier, { navigateToPage: (href: string) => assign(href) }))); });
+  for (let i = 0; i < 3; i++) await act(async () => { await new Promise((resolve) => setTimeout(resolve, 0)); });
+  return { calls, assign };
+}
+
+const settle = () => act(async () => { await new Promise((resolve) => setTimeout(resolve, 0)); });
+const tap = (element: Element) => act(async () => { element.dispatchEvent(new MouseEvent("click", { bubbles: true })); });
+const button = (label: string) => [...document.querySelectorAll<HTMLButtonElement>("button")].find((b) => b.textContent === label);
+const SEND_AND_COLLECT = "Gönder ve tahsil et";
+
+describe("Cashier counter sale: send and collect in one tap", () => {
+  it("sends the order, then opens its bill and goes to the payment page", async () => {
+    const till = await openTill(["bills.split", "orders.create"], draft());
+
+    await tap(button(SEND_AND_COLLECT)!);
+    await settle();
+
+    const submit = till.calls.findIndex((call) => call.startsWith("POST /orders/order-1/submit"));
+    const bill = till.calls.indexOf("POST /billing/bills/from-order/order-1");
+    expect(submit).toBeGreaterThanOrEqual(0);
+    expect(bill).toBeGreaterThan(submit);
+    expect(till.assign).toHaveBeenCalledWith("/cashier/payments/split-payment/index.html?billId=bill-9");
+  });
+
+  it("does not open the payment page when sending fails", async () => {
+    const till = await openTill(["bills.split", "orders.create"], draft(), 500);
+
+    await tap(button(SEND_AND_COLLECT)!);
+    await settle();
+
+    expect(till.calls.some((call) => call.includes("/billing/bills/from-order/"))).toBe(false);
+    expect(till.assign).not.toHaveBeenCalled();
+  });
+
+  it("keeps the plain send button next to it", async () => {
+    await openTill(["bills.split", "orders.create"], draft());
+
+    expect(button("Mutfağa gönder (1)")).toBeDefined();
+  });
+
+  it("offers no combined button on a table order opened as the cart", async () => {
+    sessionStorage.setItem("alkaros.table-cart-order", "order-1");
+    await openTill(["bills.split", "orders.create"], draft({ tableNumber: "5" }));
+
+    expect(button("Mutfağa gönder (1)")).toBeDefined();
+    expect(button(SEND_AND_COLLECT)).toBeUndefined();
+  });
+
+  it.each([
+    ["without the bill permission", ["orders.create"], draft()],
+    ["an empty order", ["bills.split", "orders.create"], draft({ lines: [], total: 0, subtotal: 0 })],
+  ])("offers no combined button for %s", async (_name, capabilities, order) => {
+    await openTill(capabilities, order);
+
+    expect(button(SEND_AND_COLLECT)).toBeUndefined();
+  });
+});
