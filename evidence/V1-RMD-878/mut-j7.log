/* V1-RMD-443: \"Hesaba yaz\" customer picker. */
.sp-customer-list { display: flex; flex-direction: column; gap: 6px; max-height: 260px; overflow-y: auto; }
.sp-customer {
  display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-height: 48px; padding: 8px 12px;
  border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface); color: var(--color-text);
  text-align: left; cursor: pointer; font: inherit;
}
.sp-customer.is-active { border-color: var(--color-brand); box-shadow: 0 0 0 2px var(--color-brand) inset; }
.sp-customer:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 2px; }
.sp-customer-name { font-weight: 600; }
.sp-customer-meta { font-size: 0.875rem; color: var(--color-text-muted); }

.sp-change-due { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 14px 16px; border-radius: 10px; background: var(--color-success-soft, #def4ea); color: var(--color-success, #1f6b52); font-size: 1.1rem; }
.sp-change-due strong { font-size: 1.9rem; font-variant-numeric: tabular-nums; }
.sp-quick-cash { display: grid; grid-template-columns: repeat(auto-fit, minmax(84px, 1fr)); gap: 8px; margin-top: 8px; }
.sp-change-preview { min-height: 1.4em; margin-top: 6px; font-weight: 700; }
.sp-change-preview.is-short { color: var(--color-danger, #b3261e); }

#receipt-print { display: none; }
@media print {
  body > *:not(#receipt-print) { display: none !important; }
  #receipt-print { display: block; width: 72mm; margin: 0 auto; color: #000; background: #fff; font-size: 12px; }
  #receipt-print h1 { font-size: 16px; text-align: center; margin: 0 0 4px; }
  #receipt-print table { width: 100%; border-collapse: collapse; margin: 6px 0; border-top: 1px dashed #000; }
  #receipt-print td:last-child { text-align: right; white-space: nowrap; }
  #receipt-print .sp-receipt-total td { font-weight: 700; }
  #receipt-print .sp-receipt-note { text-align: center; margin: 4px 0; }
  #receipt-print .sp-receipt-copy { text-align: center; font-size: 20px; font-weight: 400; letter-spacing: 4px; margin: 4px 0; border: 2px solid #000; }
}

.sp-fold { margin-top: 8px; }
html { scroll-padding-bottom: 80px; }
#submit-tender { position: sticky; bottom: 8px; z-index: 2; box-shadow: 0 0 0 6px var(--color-surface); }
