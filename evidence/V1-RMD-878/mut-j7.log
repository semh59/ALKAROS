.sp-btn-primary:disabled, .sp-btn-secondary:disabled, .sp-btn-danger:disabled, .sp-btn-ghost:disabled { background: var(--color-disabled); color: var(--color-text-muted); border-color: var(--color-border); }
.sp-btn-danger { background: var(--color-danger); color: #FFFFFF; }
.sp-btn-ghost { background: transparent; color: var(--color-brand); padding: 6px; font-size: 13px; min-height: auto; }

.sp-row { display: flex; gap: 10px; }
