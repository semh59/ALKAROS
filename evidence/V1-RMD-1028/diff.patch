@@ -1,11 +1,10 @@
 .bill-split { --bill-ink: #152b34; --bill-muted: #61727a; --bill-line: #bdc8cd; min-width: 0; overflow: clip; border: 1px solid var(--bill-line); border-radius: var(--ds-radius-md); color: var(--bill-ink); background: #e8eef0; box-shadow: var(--ds-shadow-raised); }
 .bill-split__header { min-height: 7rem; display: flex; align-items: center; justify-content: space-between; gap: var(--ds-space-4); padding: var(--ds-space-4); color: #f7fbfd; background: #142b35; }
 .bill-split__header > div:first-child { display: grid; gap: .18rem; }
-.bill-split__table { font-size: 1.1rem; }
 .bill-split__added { color: #9a4a00; font-weight: 800; }
 .bill-split__header span, .bill-split__review > span { color: #ffae87; font-size: .65rem; font-weight: 950; letter-spacing: .15em; }
 .bill-split__header h2 { margin: 0; font-size: clamp(1.65rem, 3vw, 2.5rem); letter-spacing: -.05em; }
-.bill-split__header p { margin: 0; color: #bdd0d7; font-size: .76rem; }
+.bill-split__header p { margin: 0; color: #bdd0d7; font-size: .76rem; overflow-wrap: anywhere; }
 .bill-split__totals { display: flex; gap: var(--ds-space-2); }
 .bill-split__totals span { min-width: 9rem; display: grid; gap: .2rem; border-left: 3px solid #ff7d49; border-radius: var(--ds-radius-sm); padding: var(--ds-space-3); color: #bdd0d7; background: rgb(255 255 255 / 7%); letter-spacing: 0; }
 .bill-split__totals strong { color: #fff; font-size: 1.3rem; }
