  align-items: flex-start;
  justify-content: center;
  padding: 24px;
}

.sp-back {
  display: inline-flex;
  align-items: center;
  min-height: var(--touch-target);
  margin: 8px 0 0 24px;
  padding: 0 8px;
  color: var(--color-brand);
  font-weight: 600;
  text-decoration: none;
}
.sp-back:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 2px; }

.sp-loading { color: var(--color-text-muted); font-size: 14px; margin-top: 40px; }

.sp-card {
  width: min(560px, 100%);
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  box-shadow: 0 1px 2px rgba(11, 33, 53, 0.06), 0 12px 32px rgba(11, 33, 53, 0.10);
  padding: 28px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-top: 24px;
}

.sp-eyebrow {
  font-size: 14px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--color-brand);
}
.sp-title { margin: 0; font-size: 22px; font-weight: 800; color: var(--color-ink); letter-spacing: -0.01em; }
.sp-subtitle { margin: 0; font-size: 14px; line-height: 1.5; color: var(--color-text-muted); }

.sp-field { display: flex; flex-direction: column; gap: 8px; }
.sp-field-label { font-size: 14px; font-weight: 600; color: var(--color-ink); }

.sp-input {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 13px 14px;
  font-size: 15px;
  font-family: inherit;
  color: var(--color-ink);
  background: var(--color-surface);
  min-height: var(--touch-target);
}
.sp-input:focus { outline: 2px solid var(--color-brand); outline-offset: 1px; }

.sp-confirm-row {
  display: flex; align-items: center; gap: 10px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 12px 14px;
  background: var(--color-canvas);
}
.sp-confirm-row input[type=\"checkbox\"] {
  width: var(--touch-target); height: var(--touch-target); flex: 0 0 auto;
  accent-color: var(--color-brand);
}
.sp-confirm-row label { font-size: 14px; line-height: 1.4; color: var(--color-ink); }

.sp-amount-field {
  display: flex; align-items: center;
  border: 1.5px solid var(--color-brand);
  border-radius: var(--radius-md);
  padding: 12px 16px;
  background: var(--color-canvas);
}
.sp-amount-field input {
  flex-grow: 1; border: none; background: transparent;
  font-size: 22px; font-weight: 700; color: var(--color-ink);
  font-family: inherit; padding: 0; min-width: 0;
}
.sp-amount-field:focus-within { outline: 3px solid var(--color-brand); outline-offset: 2px; }
.sp-amount-suffix { font-size: 16px; font-weight: 700; color: var(--color-text-muted); }

.sp-btn {
  border: none; border-radius: var(--radius-md);
  font-size: 15px; font-weight: 700; padding: 15px;
  min-height: var(--touch-target); cursor: pointer; font-family: inherit;
}
a.sp-btn { display: inline-flex; align-items: center; justify-content: center; text-decoration: none; }
.sp-btn:focus-visible { outline: 2px solid var(--color-brand); outline-offset: 2px; }
.sp-btn:disabled { cursor: not-allowed; }
.sp-btn-primary { background: var(--color-accent); color: var(--color-ink); }
.sp-btn-secondary { background: var(--color-surface); color: var(--color-ink); border: 1.5px solid var(--color-border); }
.sp-btn-primary:disabled, .sp-btn-secondary:disabled, .sp-btn-destructive:disabled, .sp-btn-danger:disabled { background: var(--color-disabled); color: var(--color-text-muted); border-color: var(--color-border); }
.sp-btn-destructive { background: var(--color-surface); color: var(--color-danger); border: 1.5px solid var(--color-danger); }
.sp-btn-danger { background: var(--color-danger); color: #FFFFFF; }

.sp-row { display: flex; gap: 16px; }
.sp-row > * { flex: 1; }


.sp-summary-row { display: flex; align-items: center; justify-content: space-between; padding: 4px 2px; font-size: 14px; }
.sp-summary-row .value { font-weight: 700; color: var(--color-ink); }
.sp-summary-row.is-total .value, .sp-summary-row.is-paid .value { font-size: 20px; }
.sp-summary-row.is-remaining { padding: 8px 2px; font-size: 15px; font-weight: 700; }
.sp-summary-row.is-remaining .value { font-size: 28px; color: var(--color-ink); }
.sp-summary-row.is-remaining.is-zero .value { color: var(--color-success); }

.sp-divider { height: 1px; background: var(--color-border); }

.sp-method-chips { display: flex; gap: 16px; flex-wrap: wrap; }
.sp-method-chip {
  border: 1.5px solid var(--color-border); border-radius: 999px;
  padding: 10px 16px; font-size: 14px; font-weight: 700; min-height: var(--touch-target);
  background: var(--color-surface); color: var(--color-ink);
  cursor: pointer; font-family: inherit;
}
.sp-method-chip.is-active { background: var(--color-ink); color: #FFFFFF; border-color: var(--color-ink); }
.sp-method-chip:disabled {
  background: var(--color-canvas); color: var(--color-text-muted);
  border-style: dashed; cursor: not-allowed;
}
.sp-hint { margin: 8px 0 0; font-size: 14px; color: var(--color-text-muted); }
.sp-drawer-notice { font-size: 16px; font-weight: 600; color: var(--color-ink); }
.sp-notice-actions { margin-top: 10px; }

.sp-line {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  border: 1px solid var(--color-border); border-radius: var(--radius-md);
  padding: 12px 14px;
}
.sp-line { flex-wrap: wrap; }
.sp-line .sp-hint { flex-basis: 100%; margin: 0; }
.sp-line .sp-field { flex: 1 1 100%; }
.sp-line-method { font-weight: 700; color: var(--color-ink); font-size: 14px; }
.sp-line-status { font-size: 14px; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
.sp-line-status.is-approved { background: rgba(23, 101, 72, 0.12); color: var(--color-success); }
.sp-line-status.is-pending { background: rgba(115, 84, 0, 0.14); color: var(--color-warning); }

.sp-alert {
  display: flex; align-items: flex-start; gap: 10px;
  border-radius: var(--radius-md); padding: 14px 16px; font-size: 14px; line-height: 1.5;
}
.sp-alert-icon {
  width: 22px; height: 22px; border-radius: 999px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 800; color: #FFFFFF; flex: 0 0 auto;
}
.sp-alert-danger { background: rgba(154, 37, 48, 0.08); }
.sp-alert-danger .sp-alert-icon { background: var(--color-danger); }
.sp-alert-danger .sp-alert-title { color: var(--color-danger); font-weight: 700; }
.sp-alert-warning { background: rgba(115, 84, 0, 0.10); }
.sp-alert-warning .sp-alert-icon { background: var(--color-warning); }
.sp-alert-warning .sp-alert-title { color: var(--color-warning); font-weight: 700; }
.sp-alert-title { font-size: 14px; }
.sp-alert-body { color: var(--color-text-muted); }

.sp-icon-circle {
  width: 52px; height: 52px; border-radius: 999px;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; font-weight: 800; align-self: center;
}
.sp-icon-circle.success { background: rgba(23, 101, 72, 0.12); color: var(--color-success); }
.sp-icon-circle.danger { background: rgba(154, 37, 48, 0.10); color: var(--color-danger); }
.sp-center-text { text-align: center; }

@media (max-width: 480px) {
  .sp-card { padding: 22px; }
}

/* V1-RMD-443: \"Hesaba yaz\" customer picker. */
.sp-customer-list { display: flex; flex-direction: column; gap: 16px; max-height: 260px; overflow-y: auto; }
.sp-customer {
  display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-height: 48px; padding: 8px 12px;
  border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface); color: var(--color-text);
  text-align: left; cursor: pointer; font: inherit;
}
.sp-customer.is-active { border-color: var(--color-brand); box-shadow: 0 0 0 2px var(--color-brand) inset; }
.sp-customer:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 2px; }
.sp-customer-name { font-weight: 600; }
.sp-customer-meta { font-size: 0.875rem; color: var(--color-text-muted); }

.sp-change-due { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 14px 16px; border-radius: 10px; background: var(--color-success-soft, #def4ea); color: var(--color-success, #1f6b52); font-size: 1.1rem; }
.sp-change-due strong { font-size: 1.9rem; font-variant-numeric: tabular-nums; }
.sp-quick-cash { display: grid; grid-template-columns: repeat(auto-fit, minmax(84px, 1fr)); gap: 16px; margin-top: 8px; }
.sp-change-preview { min-height: 1.4em; margin-top: 6px; font-weight: 700; }
.sp-change-preview.is-short { color: var(--color-danger, #b3261e); }

#receipt-print { display: none; }
@media print {
  body > *:not(#receipt-print) { display: none !important; }
  #receipt-print { display: block; width: 72mm; margin: 0 auto; color: #000; background: #fff; font-size: 12px; }
  #receipt-print h1 { font-size: 16px; text-align: center; margin: 0 0 4px; }
  #receipt-print table { width: 100%; border-collapse: collapse; margin: 6px 0; border-top: 1px dashed #000; }
  #receipt-print td:last-child { text-align: right; white-space: nowrap; }
  #receipt-print .sp-receipt-total td { font-weight: 700; }
  #receipt-print .sp-receipt-note { text-align: center; margin: 4px 0; }
  #receipt-print .sp-receipt-copy { text-align: center; font-size: 20px; font-weight: 700; letter-spacing: 4px; margin: 4px 0; border: 2px solid #000; }
}

.sp-fold { margin-top: 8px; }
html { scroll-padding-bottom: 80px; }
#submit-tender { position: sticky; bottom: 8px; z-index: 2; box-shadow: 0 0 0 6px var(--color-surface); }
.sp-place { margin: 4px 0 0; font-size: 16px; font-weight: 600; color: var(--color-text-muted); }
.sp-kitchenless-note { margin: 6px 0 0; font-size: 14px; color: var(--color-text-muted); }
/* A short screen must show the payment form up to Ödemeyi Ekle without scrolling. */
@media (max-height: 860px) {
  #submit-tender { position: static; box-shadow: none; }
  .sp-shell { padding: 8px 24px; }
  .sp-card { gap: 10px; padding-top: 16px; padding-bottom: 16px; margin-top: 0; }
  .sp-amount-field { padding: 8px 16px; }
  .sp-summary-row.is-remaining { padding: 2px; }
}
.sp-fold > summary { min-height: 48px; display: flex; align-items: center; gap: 8px; padding: 0 12px; border: 1px solid var(--color-border); border-radius: var(--radius-md); cursor: pointer; font-weight: 700; color: var(--color-ink); list-style: none; }
.sp-fold > summary::-webkit-details-marker { display: none; }
.sp-fold > summary::before { content: \"▸\"; }
.sp-fold[open] > summary::before { content: \"▾\"; }
.sp-fold > summary:focus-visible { outline: 3px solid var(--color-focus, #1F4E79); outline-offset: 2px; }
.sp-check { display: flex; align-items: flex-start; gap: 12px; min-height: 48px; cursor: pointer; }
.sp-check input { width: var(--touch-target); height: var(--touch-target); flex: none; margin: 0; }
.sp-check span { align-self: center; display: flex; flex-direction: column; gap: 4px; }
.sp-check small { color: var(--color-muted, #4d5c68); font-size: 14px; }
@media (max-height: 860px) and (min-width: 640px) {
  .sp-quick-cash { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 16px; margin-top: 4px; }
  .sp-quick-cash .sp-btn { padding: 6px 2px; font-size: 16px; }
}
