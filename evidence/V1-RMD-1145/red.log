  padding: 14px 16px;
}
.cs-stat-label { font-size: 14px; color: var(--color-text-dim); font-weight: 600; }
.cs-stat-value { font-size: 20px; font-weight: 800; color: var(--color-ink); margin-top: 4px; }

.cs-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }

.cs-status-pill {
  display: flex;
  align-items: center;
  gap: 6px;
  border-radius: 999px;
  padding: 6px 12px;
  font-size: 14px;
  font-weight: 700;
  white-space: nowrap;
}
.cs-status-pill.is-open { background: rgba(23, 101, 72, 0.12); color: var(--color-success); }
.cs-status-dot { width: 8px; height: 8px; border-radius: 999px; background: currentColor; }

.cs-divider { height: 1px; background: var(--color-border); }

.cs-alert {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  border-radius: var(--radius-md);
  padding: 14px 16px;
  font-size: 14px;
  line-height: 1.5;
}
.cs-alert-icon {
  width: 22px; height: 22px; border-radius: 999px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 800; color: #FFFFFF; flex: 0 0 auto;
}
.cs-alert-success { background: rgba(23, 101, 72, 0.10); }
.cs-alert-success .cs-alert-icon { background: var(--color-success); }
.cs-alert-success .cs-alert-title { color: var(--color-success); font-weight: 700; }
.cs-alert-danger { background: rgba(154, 37, 48, 0.08); }
.cs-alert-danger .cs-alert-icon { background: var(--color-danger); }
.cs-alert-danger .cs-alert-title { color: var(--color-danger); font-weight: 700; }
.cs-alert-warning { background: rgba(115, 84, 0, 0.10); }
.cs-alert-warning .cs-alert-icon { background: var(--color-warning); }
.cs-alert-warning .cs-alert-title { color: var(--color-warning); font-weight: 700; }
.cs-check { display: flex; align-items: center; gap: 12px; min-height: var(--touch-target); font-weight: 600; color: var(--color-text); }
.cs-check input { width: var(--touch-target); height: var(--touch-target); flex: 0 0 auto; margin: 0; }
.cs-alert-title { font-size: 14px; }
.cs-alert-body { color: var(--color-text-muted); }

.cs-icon-circle {
  width: 52px; height: 52px; border-radius: 999px;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; font-weight: 800; align-self: center;
}
.cs-icon-circle.success { background: rgba(23, 101, 72, 0.12); color: var(--color-success); }
.cs-icon-circle.danger { background: rgba(154, 37, 48, 0.10); color: var(--color-danger); }

.cs-center-text { text-align: center; }

.cs-request, .cs-movement { display: flex; flex-direction: column; gap: 4px; padding: 8px 0; border-bottom: 1px solid var(--color-border, #E5E7EB); }
.cs-request .cs-row { flex-wrap: wrap; }
.cs-note { font-size: 14px; color: var(--color-ink); overflow-wrap: anywhere; }
.cs-movement .cs-field-hint, .cs-request .cs-field-hint { color: var(--color-text-muted); font-size: 14px; }
.cs-movement.is-in .value { color: var(--color-success); }
.cs-movement.is-out .value { color: var(--color-danger); }
.cs-summary-row .value { overflow-wrap: anywhere; text-align: right; min-width: 0; }
#movement-list { max-height: 280px; overflow-y: auto; }
#movement-form { display: contents; }
.cs-chips { display: flex; flex-wrap: wrap; gap: 8px; }
.cs-chip {
  min-height: var(--touch-target); padding: 0 16px; border: 1px solid var(--color-border, #D5DBE0); border-radius: 22px;
  background: var(--color-canvas); color: var(--color-ink); font-size: 14px; font-weight: 600; cursor: pointer; font-family: inherit;
}

.cs-summary-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 4px 2px; font-size: 14px;
}
.cs-summary-row .value { font-weight: 700; color: var(--color-ink); }

.cs-error-text { color: var(--color-danger); font-size: 14px; }

/* V1-RMD-377 (module-by-module UI audit round 2, P1 - rakip karşılaştırması): kupür bazlı sayım. */
.cs-denom-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 4px; }
.cs-denom-row {
  display: grid; grid-template-columns: 64px 84px 1fr; align-items: center; gap: 10px;
  padding: 6px 2px; border-bottom: 1px solid var(--color-border);
}
.cs-denom-label { font-size: 14px; font-weight: 700; color: var(--color-ink); }
.cs-denom-count {
  min-height: var(--touch-target); padding: 0 10px; border: 1.5px solid var(--color-border);
  border-radius: var(--radius-sm); font-size: 15px; font-family: inherit; text-align: center;
}
.cs-denom-count:focus { outline: 2px solid var(--color-brand); outline-offset: 1px; }
.cs-denom-subtotal { text-align: right; font-weight: 600; color: var(--color-text-muted); }
.cs-denom-total { border-top: 2px solid var(--color-ink); margin-top: 6px; padding-top: 10px; font-size: 15px; }
.cs-denom-total .value { font-size: 18px; }

@media (max-width: 480px) {
  .cs-card { padding: 24px; }
  .cs-grid-2 { grid-template-columns: 1fr; }
}
