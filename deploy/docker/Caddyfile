# ALKAROS reverse proxy. Caddy serves the static client bundles and forwards
# the dynamic paths (JSON API + SignalR hubs) to the `api` service on plain
# HTTP inside the Compose network. TLS terminates here.
#
# Set ALKAROS_PROXY_HOST to the deployment host name or LAN IP that devices use
# (e.g. 192.168.1.50 or pos.local) so Caddy's internal CA issues a certificate
# with a matching SAN. `localhost` is always kept so the container healthcheck
# stays valid. Install the internal root CA on each device (see
# deploy/docker/README.md) for a valid secure context - the WaiterPwa service
# worker and offline queue need it.
{
	admin off
	# Clients that connect to a bare IP send no TLS SNI, so Caddy cannot tell
	# which site's certificate to present. Pin the default to ALKAROS_PROXY_HOST
	# so `https://<lan-ip>:8443` completes its handshake.
	default_sni {$ALKAROS_PROXY_HOST:localhost}
}

# V1-RMD-335 (independent 2026-09-26 audit, orta seviye bulgu): none of the
# vhosts below set a single security response header. Applied at the site
# level so it covers every handle (static files AND the reverse-proxied API/
# hub responses) in one place. Deliberately conservative: no
# Content-Security-Policy (would need auditing every inline script/style the
# SPA bundles actually use first - a real risk of silently breaking the app,
# out of this finding's own scope) and no Strict-Transport-Security (this
# deployment's TLS is `tls internal`, a per-device-installed root CA on a LAN
# - HSTS pinning a device to HTTPS-only before that CA install is confirmed
# working risks locking a device out of the app entirely, which is worse than
# the header's own absence). The headers below carry no such risk.
(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
	}
}

# Static SPA + client shells. try_files falls back to the app shell for deep
# links; real files (hashed assets, /waiter/*, /cashier/*) are served directly.
(spa_static) {
	encode gzip
	root * /srv/app
	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}

{$ALKAROS_PROXY_HOST:localhost}, localhost {
	tls internal

	import security_headers

	# The customer-display origin signal (finding B-4) must originate here,
	# never from a client - strip any inbound copy before proxying.
	handle /api/* {
		reverse_proxy api:5080 {
			header_up -X-Alkaros-Origin
		}
	}
	handle /hubs/* {
		reverse_proxy api:5080 {
			header_up -X-Alkaros-Origin
		}
	}
	handle /health/* {
		reverse_proxy api:5080 {
			header_up -X-Alkaros-Origin
		}
	}
	import spa_static
}

# The customer display is a distinct browser origin from the cashier, so its
# localStorage - and the cashier terminal id / bill id - never leak across
# (finding B-4). Only the customer-display API and hub are proxied here, each
# tagged with X-Alkaros-Origin: display so the api restricts the request to the
# display route allowlist. Point the displays at
# https://display.<ALKAROS_PROXY_HOST>/display and install the same root CA.
display.{$ALKAROS_PROXY_HOST:localhost} {
	tls internal

	import security_headers

	# Every dynamic path is tagged as the display origin and proxied to the
	# api; the api admits only the customer-display routes and answers any
	# other /api or /hubs path here with a 404 (finding B-4). Keeping the
	# allow/deny decision in the api - not split across Caddy - means one
	# place owns the isolation contract.
	handle /api/* {
		reverse_proxy api:5080 {
			header_up X-Alkaros-Origin display
		}
	}
	handle /hubs/* {
		reverse_proxy api:5080 {
			header_up X-Alkaros-Origin display
		}
	}
	import spa_static
}

# V1-RMD-142: the LAN counterpart to the public relay's own NFC/QR origin
# (V1-RMD-140/141's --nfc-loopback-origin, --nfc-web-root, --qr-web-root) -
# a customer on the restaurant's own WiFi reaches the exact same isolated
# surface a relay-connected customer does, just through this vhost instead
# of the tunnel. `/api/v1/nfc/*` and `/api/v1/qr/*` are both tagged
# X-Alkaros-Origin: nfc (the api's own origin gate treats NFC and QR as one
# combined customer-ordering category, isNfcApi - see
# DualScreenApplication.cs), so this vhost never reaches any Cashier/
# manager route either. The two static bundles are the SAME isolated
# builds the relay path serves - not the full PosTerminal SPA - so this
# origin never carries Cashier/RelaySettings/ReservationStation's own code
# or route names, on the LAN any more than through the tunnel. Point NFC
# tags/QR codes at https://nfc.<ALKAROS_PROXY_HOST>/nfc/{tableId} or
# /qr/?t=<token> and install the same root CA.
nfc.{$ALKAROS_PROXY_HOST:localhost} {
	tls internal

	import security_headers

	handle /api/v1/nfc/* {
		reverse_proxy api:5080 {
			header_up X-Alkaros-Origin nfc
		}
	}
	handle /api/v1/qr/* {
		reverse_proxy api:5080 {
			header_up X-Alkaros-Origin nfc
		}
	}
	# handle_path strips the matched prefix before the file root below sees
	# it - neither bundle's own files are nested under an /nfc or /qr
	# directory on disk (Vite's own base:"/nfc/" only affects the HTML's
	# asset *references*, not dist-nfc/'s own layout).
	handle_path /nfc/* {
		root * /srv/nfc-app
		try_files {path} /index.html
		file_server
	}
	handle_path /qr/* {
		root * /srv/qr-app
		try_files {path} {path}/ /index.html
		file_server
	}
	# Everything else - Cashier/manager API paths above all - must be a real
	# 404, not Caddy's own unmatched-request default (an empty 200): found
	# while testing this vhost for the first time, no handler here matched
	# /api/v1/terminals/* and Caddy answered 200 itself without ever
	# reaching `api` at all. The other vhosts get this for free from
	# spa_static's own catch-all `handle {}`; this vhost has no such import.
	handle {
		respond 404
	}
}
