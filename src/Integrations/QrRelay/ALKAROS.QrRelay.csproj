<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ALKAROSModule>true</ALKAROSModule>
    <RootNamespace>ALKAROS.QrRelay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads the relay credential the QrOrdering module owns (V12-QRT-003);
         does not write to or otherwise reach into that module's schema. -->
    <ProjectReference Include="..\..\Modules\QrOrdering\ALKAROS.QrOrdering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- V12-QRT-005: ConnectorHost is its own executable project nested
         under LocalConnector/ - the SDK's default item glob does not
         exclude a nested project's own folder automatically, so without
         this it would try to compile ConnectorHost/Program.cs into this
         library too (and fail: this project has no
         Microsoft.Extensions.Hosting reference, only .Abstractions). -->
    <Compile Remove="LocalConnector\ConnectorHost\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <!-- V12-QRT-001 LocalConnector: BackgroundService/IHostedService (Hosting)
         and ILogger<T>/LoggerMessage (Logging) — this project has no
         ASP.NET Core framework reference to bring these in transitively. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
