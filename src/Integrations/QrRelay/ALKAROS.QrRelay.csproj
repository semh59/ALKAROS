<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ALKAROSModule>true</ALKAROSModule>
    <RootNamespace>ALKAROS.QrRelay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reads the relay credential the QrOrdering module owns (V12-QRT-003);
         does not write to or otherwise reach into that module's schema. -->
    <ProjectReference Include="..\..\Modules\QrOrdering\ALKAROS.QrOrdering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
    <!-- V12-QRT-001 LocalConnector: BackgroundService/IHostedService (Hosting)
         and ILogger<T>/LoggerMessage (Logging) — this project has no
         ASP.NET Core framework reference to bring these in transitively. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
