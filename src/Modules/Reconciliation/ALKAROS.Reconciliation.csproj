<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ALKAROSModule>true</ALKAROSModule>
    <RootNamespace>ALKAROS.Reconciliation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\ModuleComposition\ALKAROS.ModuleComposition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- V13-REC-001: PaymentReconciliationModule reads payments.*/cash.*
         directly via plain SQL (a read model, no ProjectReference to
         ALKAROS.Payments/ALKAROS.Cash) and resolves the shared
         NpgsqlDataSource through a DI factory registration. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

</Project>
