<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ALKAROSModule>true</ALKAROSModule>
    <RootNamespace>ALKAROS.Billing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orders\ALKAROS.Orders.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\ModuleComposition\ALKAROS.ModuleComposition.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\IntegrationContracts\ALKAROS.IntegrationContracts.csproj" />
  </ItemGroup>

  <!-- V13-ALC-002: PaymentClosure/** is its own separate project
       (ALKAROS.Billing.PaymentClosure.csproj), not part of this assembly -
       it needs ALKAROS.Payments.csproj, and Payments already references
       THIS project, so a reference the other way would cycle. Excluded
       here so the SDK's default **/*.cs glob does not also compile it into
       this assembly. -->
  <ItemGroup>
    <Compile Remove="PaymentClosure\**\*.cs" />
  </ItemGroup>

</Project>
