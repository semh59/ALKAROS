<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ALKAROSModule>true</ALKAROSModule>
    <RootNamespace>ALKAROS.CustomerAccounts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- CustomerAccountsModule.cs/CustomerAccountsBillChargesModule.cs register
         these into ModuleRegistry.DefaultCatalog. -->
    <ProjectReference Include="..\..\BuildingBlocks\ModuleComposition\ALKAROS.ModuleComposition.csproj" />
    <!-- V14-ACC-003: BillCharges composes Payment/PaymentAllocation (and,
         transitively, Bill/BillAdjustment) alongside its own AccountTransaction
         ledger write - mirrors ALKAROS.Cash.csproj's own single-reference
         pattern for the exact same reason (referencing ALKAROS.Payments.csproj
         alone already brings Billing and Payments.Allocations.Persistence
         along, since neither is excluded from that assembly). -->
    <ProjectReference Include="..\Payments\ALKAROS.Payments.csproj" />
    <!-- V14-ACC-003: eligibility checks the customer profile exists and is
         not anonymized before a charge can be posted against their account. -->
    <ProjectReference Include="..\CustomerData\ALKAROS.CustomerData.csproj" />
    <!-- V14-ACC-005: a cash account receipt records its CashIn movement through the Cash ledger. -->
    <ProjectReference Include="..\Cash\ALKAROS.Cash.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PostgresAccountTransactionLedger. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
