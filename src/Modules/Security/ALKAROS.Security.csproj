<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ALKAROSProjectKind>buildingblock</ALKAROSProjectKind>
    <RootNamespace>ALKAROS.Security</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Security\Secrets\ALKAROS.Secrets.csproj" />
    <!-- V15-SEC-002: IdentityHardening composes with Identity's own
         AuthenticationService/IUserStore/IDeviceSessionService instead of
         duplicating their persistence. -->
    <ProjectReference Include="..\Identity\ALKAROS.Identity.csproj" />
    <!-- V15-SEC-003: DataProtectionRetention protects/unprotects envelopes
         through the V1-SEC-002 SensitiveData boundary and persists them
         directly (security.retention_subjects, migration 137). -->
    <ProjectReference Include="..\..\BuildingBlocks\Security\SensitiveData\ALKAROS.SensitiveData.csproj" />
    <!-- V15-SEC-003: disposal/purge/re-encryption actions are recorded
         through V1-OPS-001's audit foundation (its own declared dependency). -->
    <ProjectReference Include="..\Audit\ALKAROS.Audit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- V15-SEC-003: PostgresRetentionSubjectStore. -->
    <PackageReference Include="Npgsql" />
  </ItemGroup>

</Project>
