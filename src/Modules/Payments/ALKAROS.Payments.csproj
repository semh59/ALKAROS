<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ALKAROSModule>true</ALKAROSModule>
    <RootNamespace>ALKAROS.Payments</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\ModuleComposition\ALKAROS.ModuleComposition.csproj" />
    <ProjectReference Include="..\Billing\ALKAROS.Billing.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Security\Secrets\ALKAROS.Secrets.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Security\SensitiveData\ALKAROS.SensitiveData.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Messaging\ALKAROS.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <!-- V13-PAY-003: TenderComposition/** is its own separate project
       (ALKAROS.Payments.TenderComposition.csproj), not part of this
       assembly - it needs ALKAROS.Cash.csproj, and Cash already references
       THIS project, so a reference the other way would cycle. Excluded
       here so the SDK's default **/*.cs glob does not also compile it into
       this assembly (same precedent as ALKAROS.Billing.csproj's
       PaymentClosure exclusion, V13-ALC-002). -->
  <ItemGroup>
    <Compile Remove="TenderComposition\**\*.cs" />
  </ItemGroup>

</Project>
