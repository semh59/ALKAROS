<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ALKAROSTest>true</ALKAROSTest>
    <IsPackable>false</IsPackable>
    <RootNamespace>ALKAROS.Host.Experience.HelpRequests.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <!-- V1-RMD-289: HelpRequestHubTests fakes a HubCallerContext/IGroupManager for a direct, real-Postgres
         unit test of OnConnectedAsync - needs the shared framework's SignalR/Http.Features types, same as
         SecurityAdministration's own test project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/Host/ALKAROS.Host.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/TestHelpers/ALKAROS.TestHelpers.csproj" />
  </ItemGroup>

  <!-- Only what the help-request endpoint touches: users, device sessions,
       table_mgmt (010, the table a request is raised against), 096 (creates
       the notifications schema this area's own migration builds on), and
       101 itself. Ordered by file name, which is why the numeric prefixes
       matter. -->
  <ItemGroup>
    <None Include="../../../../database/migrations/V1/V1-IAM-001/005-users.up.sql" Link="Fixtures\sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../database/migrations/V1/V1-IAM-003/009-identity-device-sessions.up.sql" Link="Fixtures\sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../database/migrations/V1/V1-TBL-001/010-tables.up.sql" Link="Fixtures\sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../database/migrations/V1/V1-WTR-011/096-push-subscriptions.up.sql" Link="Fixtures\sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../database/migrations/V1/V1-WTR-014/101-help-requests.up.sql" Link="Fixtures\sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- V1-SET-004: settings.settings/setting_history, queried by
         HelpRequestStore.RaiseAsync via GarsonFeatureToggles.IsEnabledAsync. -->
    <None Include="../../../../database/migrations/V1/V1-SET-001/026-typed-settings.up.sql" Link="Fixtures\sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
